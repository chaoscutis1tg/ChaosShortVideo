# Cấu hình API Keys cho ChaosShortVideo
# Lấy miễn phí Gemini API Key tại: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Kho Stock Video miễn phí (dành cho Chế độ Tạo Video Từ Chủ Đề)
# Lấy miễn phí tại: https://www.pexels.com/api/ và https://pixabay.com/api/docs/
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Cổng Giọng đọc Thương mại Tầng 3 (Tùy chọn nâng cấp khi cần)
ELEVENLABS_API_KEY=
VBEE_API_KEY=
VBEE_APP_ID=
FPT_AI_API_KEY=

# Cấu hình phần cứng
PREFER_NVENC_GPU=true
WHISPER_MODEL_SIZE=medium
WHISPER_COMPUTE_TYPE=float16
